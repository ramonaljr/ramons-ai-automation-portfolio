{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "ramons-ai-automation-portfolio.vercel.app" }],
      "destination": "https://ramonvallejera.com/$1",
      "permanent": true
    }
  ]
}

# n8n instance backing the contact form, booking calendar and chat widget.
#
# Server-side only — deliberately NOT prefixed NEXT_PUBLIC_. The browser calls
# this app's /api routes, which forward to n8n from the server, so the instance
# URL stays out of the client bundle and n8n needs no CORS configuration.
#
# Every environment, local and production, points at the hosted n8n on the
# Hostinger VPS. The old Tailscale tunnel to a laptop went down whenever the
# laptop slept, and took booking, contact and chat down with it.
N8N_BASE_URL=https://n8n.ramonvallejera.com

# Shared secret proving a webhook call came from this app rather than the open
# internet. Must match the "Portfolio Webhook Key" credential in n8n, which the
# webhook nodes enforce as Header Auth on X-Portfolio-Key.
#
# The workflows behind those webhooks create real Google Calendar events and
# send real email, so this is what stands between the endpoints and anyone who
# discovers the URL. Generate with: openssl rand -hex 32
N8N_WEBHOOK_KEY=

# Supabase project behind the private client dashboard (/login, /dashboard).
#
# Both are safe in the browser by design: the anon / publishable key can only
# do what the row-level security policies in supabase/dashboard.sql allow,
# which is nothing without a signed-in session. Run that file once in the
# Supabase SQL editor, create your user, and turn sign-ups off. Left empty,
# the site builds normally and /login says the dashboard isn't connected.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

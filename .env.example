# n8n instance backing the contact form, booking calendar and chat widget.
#
# Server-side only — deliberately NOT prefixed NEXT_PUBLIC_. The browser calls
# this app's /api routes, which forward to n8n from the server, so the instance
# URL stays out of the client bundle and n8n needs no CORS configuration.
#
# Local development points at the Docker instance. A deployed site needs n8n on
# a public HTTPS host (tunnel, VPS or n8n Cloud) and this set to that origin.
N8N_BASE_URL=http://localhost:5678

# Shared secret proving a webhook call came from this app rather than the open
# internet. Must match the "Portfolio Webhook Key" credential in n8n, which the
# webhook nodes enforce as Header Auth on X-Portfolio-Key.
#
# The workflows behind those webhooks create real Google Calendar events and
# send real email, so this is what stands between the endpoints and anyone who
# discovers the URL. Generate with: openssl rand -hex 32
N8N_WEBHOOK_KEY=
